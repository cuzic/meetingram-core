      "grounds": [
        16,
        17
      ]
    },
    {
      "id": "g8",
      "kind": "argument",
      "text": "競合が年内に同様の機能を出す可能性がある",
      "status": "open",
      "grounds": [
        22,
        23,
        24
      ]
    },
    {
      "id": "g9",
      "kind": "position",
      "text": "1週間延期して12月17日にリリースする",
      "status": "retracted",
      "grounds": [
        31,
        36,
        106
      ]
    },
    {
      "id": "g10",
      "kind": "argument",
      "text": "同期機能の回帰テストが6割しか終わっていない",
      "status": "open",
      "grounds": [
        10
      ]
    },
    {
      "id": "g11",
      "kind": "argument",
      "text": "前回v3.1でテスト未完了のまま出して同期の障害が起きた",
      "status": "open",
      "grounds": [
        27,
        29
      ]
    },
    {
      "id": "g12",
      "kind": "position",
      "text": "2週間延期する",
      "status": "retracted",
      "grounds": [
        39,
        48
      ]
    },
    {
      "id": "g13",
      "kind": "argument",
      "text": "2週間延期すると年末年始にかかりリリース後の対応体制が薄い",
      "status": "open",
      "grounds": [
        43,
        44,
        45
      ]
    },
    {
      "id": "g14",
      "kind": "position",
      "text": "同期機能だけフィーチャーフラグでオフにして12月10日にリリースする",
      "status": "open",
      "grounds": [
        51,
        56,
        103,
        104
      ]
    },
    {
      "id": "g15",
      "kind": "argument",
      "text": "同期をフラグで切ればリスクのある部分がユーザーに出ない",
      "status": "open",
      "grounds": [
        55
      ]
    },
    {
      "id": "g16",
      "kind": "argument",
      "text": "フラグをオフにした状態自体がテストされていない",
      "status": "open",
      "grounds": [
        60,
        61,
        65
      ]
    },
    {
      "id": "g17",
      "kind": "argument",
      "text": "v3.0でも同じフラグの仕組みで共有リンク機能を止めて問題なかった",
      "status": "open",
      "grounds": [
        63,
        64
      ]
    },
    {
      "id": "g18",
      "kind": "argument",
      "text": "A社が一番待っているのは同期機能なので外して出す意味が薄い",
      "status": "open",
      "grounds": [
        68,
        69
      ]
    },
    {
      "id": "g19",
      "kind": "position",
      "text": "自動テストを追加で書いて同期のテスト不足を補う",
      "status": "retracted",
      "grounds": [
        80,
        81,
        87
      ]
    },
    {
      "id": "g20",
      "kind": "argument",
      "text": "自動テスト追加には5日程度かかり12月10日に間に合わない",
      "status": "open",
      "grounds": [
        84,
        85
      ]
    },
    {
      "id": "g21",
      "kind": "position",
      "text": "同期まわりの探索的テストを2日間集中して行う",
      "status": "open",
      "grounds": [
        90,
        91
      ]
    },
    {
      "id": "g22",
      "kind": "argument",
      "text": "探索的テストの中でフラグをオフにした状態も確認できる",
      "status": "open",
      "grounds": [
        93,
        94,
        159
      ]
    },
    {
      "id": "g23",
      "kind": "position",
      "text": "A社に事前連絡し同期は1月中旬めどになると説明する",
      "status": "open",
      "grounds": [
        114,
        121
      ]
    },
    {
      "id": "g24",
      "kind": "argument",
      "text": "後で気づかれるより先に伝えた方がよい",
      "status": "open",
      "grounds": [
        113
      ]
    },
    {
      "id": "g25",
      "kind": "argument",
      "text": "A社は以前、事前相談なしの仕様変更で強く不満を示した",
      "status": "open",
      "grounds": [
        116,
        117,
        118
      ]
    },
    {
      "id": "g26",
      "kind": "position",
      "text": "当番を決めて当番1人の承認でホットフィックスを出せるようにする",
      "status": "open",
      "grounds": [
        131
      ]
    },
    {
      "id": "g27",
      "kind": "argument",
      "text": "現行ルールは承認2人必要で夜間に2人目が捕まらず3時間止まった",
      "status": "open",
      "grounds": [
        128,
        129
      ]
    },
    {
      "id": "g28",
      "kind": "argument",
      "text": "1人承認だとレビューが甘くなる",
      "status": "open",
      "grounds": [
        133,
        134
      ]
    },
    {
      "id": "g29",
      "kind": "position",
      "text": "夜間のみ当番1人承認とし翌営業日朝にもう1人が事後レビュー、昼間は従来通り2人",
      "status": "open",
      "grounds": [
        139,
        142
      ]
    },
    {
      "id": "g30",
      "kind": "decision",
      "text": "v3.2は12月10日に予定通りリリースし、同期機能はフラグでオフにする",
