{
  "nodes": [
    {
      "id": "i1",
      "kind": "issue",
      "text": "障害時にどの単位まで復旧できるようにするか",
      "status": "open",
      "grounds": [
        2,
        4
      ]
    },
    {
      "id": "p1",
      "kind": "position",
      "text": "セグメント単位で確定側へ移す",
      "status": "open",
      "grounds": [
        5,
        8
      ]
    },
    {
      "id": "a1",
      "kind": "argument",
      "text": "中断後も確定分を読み取れる",
      "status": "open",
      "grounds": [
        7
      ]
    },
    {
      "id": "a2",
      "kind": "argument",
      "text": "開いたままのファイルは Windows で移動できない",
      "status": "open",
      "grounds": [
        9,
        11,
        15
      ]
    },
    {
      "id": "a3",
      "kind": "argument",
      "text": "読み手は確定側だけを見るため競合を避けられる",
      "status": "open",
      "grounds": [
        16
      ]
    },
    {
      "id": "d1",
      "kind": "decision",
      "text": "ファイルを閉じてから移動しセグメント単位で確定する",
      "status": "open",
      "grounds": [
        14,
        17
      ]
    },
    {
      "id": "t1",
      "kind": "action",
      "text": "三つの中断箇所を使って復旧試験を書く",
      "status": "open",
      "grounds": [
        18,
        123
      ]
    },
    {
      "id": "i2",
      "kind": "issue",
      "text": "書き込み待ちが積み上がったらどう対処するか",
      "status": "open",
      "grounds": [
        32,
        41,
        52,
        127
      ]
    },
    {
      "id": "p2",
      "kind": "position",
      "text": "バッファを無制限にする",
      "status": "open",
      "grounds": [
        33,
        50
      ]
    },
    {
      "id": "a4",
      "kind": "argument",
      "text": "無制限ではメモリが増える",
      "status": "open",
      "grounds": [
        34
      ]
    },
    {
      "id": "p3",
      "kind": "position",
      "text": "固定の上限を付けて手前で待つ",
      "status": "open",
      "grounds": [
        36,
        39,
        50
      ]
    },
    {
      "id": "a5",
      "kind": "argument",
      "text": "録音コールバックで待つと録音が途切れる",
      "status": "open",
      "grounds": [
        37,
        38
      ]
    },
    {
      "id": "a6",
      "kind": "argument",
      "text": "別タスクで待っても受け口があふれる",
      "status": "open",
      "grounds": [
        40
      ]
    },
    {
      "id": "t2",
      "kind": "action",
      "text": "ピークのバッファ量を測る",
      "status": "open",
      "grounds": [
        51,
        53,
        58,
        125
      ]
    },
    {
      "id": "i3",
      "kind": "issue",
      "text": "ヘッダーに版を付けるか",
      "status": "open",
      "grounds": [
        63
      ]
    },
    {
      "id": "p4",
      "kind": "position",
      "text": "先頭に一バイトの版を付ける",
      "status": "open",
      "grounds": [
        64
      ]
    },
    {
      "id": "a7",
      "kind": "argument",
      "text": "版だけでは破損データと区別しにくい",
      "status": "open",
      "grounds": [
        65
      ]
    },
    {
      "id": "p5",
      "kind": "position",
      "text": "目印と版の組を置く",
