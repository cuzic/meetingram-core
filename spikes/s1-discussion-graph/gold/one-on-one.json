{
  "nodes": [
    {
      "id": "i1",
      "kind": "issue",
      "text": "定時直前に来る質問をどう扱うか",
      "grounds": [
        2,
        3,
        4
      ]
    },
    {
      "id": "p1",
      "kind": "position",
      "text": "メッセージを確認する時間を二回に固定する",
      "grounds": [
        5,
        19
      ]
    },
    {
      "id": "a1",
      "kind": "argument",
      "text": "確認の時間を固定すると集中が途切れにくい",
      "grounds": [
        6
      ]
    },
    {
      "id": "a2",
      "kind": "argument",
      "text": "確認時間外に急ぐ質問まで止める恐れがある",
      "grounds": [
        8
      ]
    },
    {
      "id": "p2",
      "kind": "position",
      "text": "急ぐ質問には別の目印を付ける",
      "grounds": [
        9,
        93,
        94
      ]
    },
    {
      "id": "a3",
      "kind": "argument",
      "text": "目印を使うには関係者への周知が要る",
      "grounds": [
        10
      ]
    },
    {
      "id": "p3",
      "kind": "position",
      "text": "隣の担当と小さく試す",
      "grounds": [
        11,
        12
      ]
    },
    {
      "id": "d1",
      "kind": "decision",
      "text": "隣の担当と一週間、午前と午後に一度ずつ確認し急ぎは従来どおり受ける",
      "grounds": [
        19,
        21
      ]
    },
    {
      "id": "t1",
      "kind": "action",
      "text": "明日の午前に隣の担当に声をかける",
      "grounds": [
        20,
        104
      ]
    },
    {
      "id": "t2",
      "kind": "action",
      "text": "週末に質問件数を記録する",
      "grounds": [
        23,
        97,
        104
      ]
    },
    {
      "id": "i2",
      "kind": "issue",
      "text": "発表でどこまで説明するか",
      "grounds": [
        27,
        28
      ]
    },
    {
      "id": "p4",
      "kind": "position",
      "text": "目的を冒頭に置き詳細は末尾に回す",
      "grounds": [
        30,
        33
      ]
    },
    {
      "id": "a4",
      "kind": "argument",
      "text": "目的が先だと話を追いやすい",
      "grounds": [
        31
      ]
    },
    {
      "id": "a5",
      "kind": "argument",
      "text": "時間切れで詳細が飛ぶ恐れがある",
      "grounds": [
        32
      ]
    },
    {
      "id": "d2",
      "kind": "decision",
      "text": "発表資料は目的を先にして詳細を末尾に置く",
      "grounds": [
        40
      ]
    },
    {
      "id": "t3",
      "kind": "action",
      "text": "発表資料の最初と最後のページを書く",
      "grounds": [
        41,
        100,
        105
      ]
    },
    {
      "id": "i3",
      "kind": "issue",
      "text": "発表前の読み合わせを誰に頼めるか",
      "grounds": [
        44
      ]
    },
    {
      "id": "p5",
      "kind": "position",
      "text": "相談相手が十分ほど資料を確認する",
      "grounds": [
        45,
        48
      ]
    },
    {
      "id": "t4",
      "kind": "action",
      "text": "発表の読み合わせ枠を用意する",
      "grounds": [
        99,
        101,
        110
      ]
    },
    {
      "id": "i4",
      "kind": "issue",
      "text": "見積もりのずれに早く気づくにはどうするか",
      "grounds": [
        51,
        52,
        108
      ]
    },
    {
      "id": "p6",
      "kind": "position",
      "text": "初日に小さな試作を作る",
      "grounds": [
        53
      ]
    },
    {
      "id": "a6",
      "kind": "argument",
      "text": "試作で不明点を早く見つけられる",
      "grounds": [
        54
      ]
    },
    {
      "id": "a7",
      "kind": "argument",
      "text": "小さな作業まで試作すると工数が増える",
      "grounds": [
        55
      ]
    },
    {
      "id": "p7",
      "kind": "position",
      "text": "最初に不明点を一つ書き出す",
      "grounds": [
        57
      ]
    },
    {
      "id": "a8",
      "kind": "argument",
      "text": "不明点を書いても確認時間は分からない",
      "grounds": [
        58
      ]
    },
    {
      "id": "p8",
      "kind": "position",
      "text": "確認先を先に押さえる",
      "grounds": [
        67
      ]
    },
    {
      "id": "a9",
      "kind": "argument",
      "text": "確認先全員とは枠を取れない",
      "grounds": [
        68
      ]
    },
    {
      "id": "t5",
      "kind": "action",
      "text": "最近の確認待ち時間を調べて次回の相談に持参する",
      "grounds": [
        62,
        63,
        64,
        106
      ]
    },
    {
      "id": "i5",
      "kind": "issue",
      "text": "短い休憩をいつ取るか",
      "grounds": [
        71,
        72
      ]
    },
    {
      "id": "p9",
      "kind": "position",
      "text": "午後の中間に短く休む",
      "grounds": [
        74
      ]
    },
    {
      "id": "a10",
      "kind": "argument",
      "text": "午後の休憩で作業の区切りが作れる",
      "grounds": [
        75
      ]
    },
    {
      "id": "a11",
      "kind": "argument",
      "text": "午後の固定休憩は会議に重なる",
      "grounds": [
        76
      ]
    },
    {
      "id": "p10",
      "kind": "position",
      "text": "会議直後を休憩の区切りにする",
      "grounds": [
        77,
        79
      ]
    },
    {
      "id": "t6",
      "kind": "action",
      "text": "会議の直後に休憩を取る方法を試す",
      "grounds": [
        80
      ]
    },
    {
      "id": "i6",
      "kind": "issue",
      "text": "午後のメッセージ確認は何時に始めるか",
