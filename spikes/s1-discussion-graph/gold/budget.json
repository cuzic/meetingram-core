    {
      "id": "a1",
      "kind": "argument",
      "text": "補助が入れば棚卸しが進む",
      "grounds": [
        6
      ]
    },
    {
      "id": "a2",
      "kind": "argument",
      "text": "引き継ぎを教える人が空いていない",
      "grounds": [
        7,
        9
      ]
    },
    {
      "id": "p2",
      "kind": "position",
      "text": "棚卸しを金曜午前に小分けにする",
