{
  "nodes": [
    {
      "id": "i1",
      "kind": "issue",
      "text": "障害時にどの単位まで復旧できるようにするか",
      "grounds": [
        2,
        4
      ]
    },
    {
      "id": "p1",
      "kind": "position",
      "text": "セグメント単位で確定側へ移す",
      "grounds": [
        5,
        8
      ]
    },
    {
      "id": "a1",
      "kind": "argument",
      "text": "中断後も確定分を読み取れる",
      "grounds": [
        7
      ]
    },
    {
      "id": "a2",
      "kind": "argument",
      "text": "開いたままのファイルは Windows で移動できない",
      "grounds": [
        9,
        11,
        15
      ]
    },
    {
      "id": "a3",
      "kind": "argument",
      "text": "読み手は確定側だけを見るため競合を避けられる",
      "grounds": [
        16
      ]
    },
    {
      "id": "d1",
      "kind": "decision",
      "text": "ファイルを閉じてから移動しセグメント単位で確定する",
      "grounds": [
        14,
        18
      ]
    },
    {
      "id": "t1",
      "kind": "action",
      "text": "三つの中断箇所を使って復旧試験を書く",
      "grounds": [
        19,
        99
      ]
    },
    {
      "id": "i2",
      "kind": "issue",
      "text": "書き込み待ちが積み上がったらどう対処するか",
      "grounds": [
        26,
        35,
        104
      ]
    },
    {
      "id": "p2",
      "kind": "position",
      "text": "バッファを無制限にする",
      "grounds": [
        27,
        45
      ]
    },
    {
      "id": "a4",
      "kind": "argument",
      "text": "無制限ではメモリが増える",
      "grounds": [
        28
      ]
    },
    {
      "id": "p3",
      "kind": "position",
      "text": "固定の上限を付けて手前で待つ",
      "grounds": [
        30,
        33,
        45
      ]
    },
    {
      "id": "a5",
      "kind": "argument",
      "text": "録音コールバックで待つと録音が途切れる",
      "grounds": [
        31,
        32
      ]
    },
    {
      "id": "a6",
      "kind": "argument",
      "text": "別タスクで待っても受け口があふれる",
      "grounds": [
        34
      ]
    },
    {
      "id": "t2",
      "kind": "action",
      "text": "ピークのバッファ量を測る",
      "grounds": [
        46,
        101
      ]
    },
    {
      "id": "i3",
      "kind": "issue",
      "text": "ヘッダーに版を付けるか",
      "grounds": [
        52
      ]
    },
    {
      "id": "p4",
      "kind": "position",
      "text": "先頭に一バイトの版を付ける",
      "grounds": [
        53
      ]
    },
    {
      "id": "a7",
      "kind": "argument",
      "text": "版だけでは破損データと区別しにくい",
      "grounds": [
        54
      ]
    },
    {
      "id": "p5",
      "kind": "position",
      "text": "目印と版の組を置く",
      "grounds": [
        55,
        56
      ]
    },
    {
      "id": "d2",
      "kind": "decision",
      "text": "最初から目印と版を付ける",
      "grounds": [
        61,
        106
      ]
    },
    {
      "id": "t3",
      "kind": "action",
      "text": "旧形式サンプルを読んだ場合のエラーを確認する",
      "grounds": [
        62,
        100
      ]
    },
    {
      "id": "i4",
      "kind": "issue",
      "text": "読み手のエラーをどう通知するか",
      "grounds": [
        86,
        92,
        102
      ]
    },
    {
      "id": "p6",
      "kind": "position",
      "text": "警告を一度だけ出す",
      "grounds": [
        87
      ]
    },
    {
      "id": "a8",
      "kind": "argument",
      "text": "一度の警告では気づかない可能性がある",
      "grounds": [
        90
      ]
    },
    {
      "id": "p7",
      "kind": "position",
      "text": "繰り返しエラーは件数を付ける",
      "grounds": [
        88
      ]
    },
    {
      "id": "t4",
      "kind": "action",
      "text": "警告の文言の長さを確認する",
      "grounds": [
        94,
        95
      ]
    },
    {
      "id": "i5",
      "kind": "issue",
      "text": "どの順番でレビューするか",
      "grounds": [
        73
      ]
    },
    {
      "id": "p8",
